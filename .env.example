###############################################################################
# HOME-OPS ENVIRONMENT CONFIGURATION
#
# Instructions:
# - Uncommented lines are REQUIRED and must be filled out.
# - Commented lines (#) show the default values used by the stack.
#   Uncomment them ONLY if you need to override the default behavior.
# - Stateful apps use isolated PUIDs/PGIDs (1001+) for host filesystem security.
###############################################################################

###############################################################################
# SECTION 1: SHARED CONFIGURATION
###############################################################################

# --- Global Secrets ---
CLOUDFLARE_PRIMARY_ZONE_ID="your_primary_zone_id"
CLOUDFLARE_SECONDARY_ZONE_ID="your_secondary_zone_id"
CLOUDFLARE_TOKEN="your_cloudflare_token"
GANDIV5_PERSONAL_ACCESS_TOKEN="your_access_token"
MARIADB_ROOT_PASSWORD="your_mariadb_password"

# GITHUB_PERSONAL_ACCESS_TOKEN=""

# --- Global Network Configuration ---
# DOMAIN_PRIMARY="localhost"
# DOMAIN_SECONDARY="localhost"
# GATEWAY_IPV4_ADDR="127.0.0.1"
# GATEWAY_IPV6_ADDR="::1"
# GATEWAY_NAME="gateway.localhost"
# HOST_LOCAL_IPV4_ADDR="127.0.0.1"
# HOST_LOCAL_IPV4_SUBNET="192.168.178.0/24"
# HOST_LOCAL_IPV6_ADDR="::1"
# HOST_LOCAL_IPV6_SUBNET="fd00::/8"

# --- System & Identity ---
# Default User/Group IDs for stateless containers and docker socket group
# DOCKER_SOCKET_PGID=987
# PGID=1000
# PUID=1000
# TZ="Etc/UTC"

# --- Templates & Core Image Tags ---
# ALPINE_DOCKER_TAG="3.23"
# BUSYBOX_DOCKER_TAG="1.38"
# MARIADB_DOCKER_TAG="12.3"
# NGINX_UNPRIVILEGED_DOCKER_TAG="latest"


###############################################################################
# SECTION 2: CORE / ROUTING
###############################################################################

# --- DDNS Updater ---
# DDNS_UPDATER_DOCKER_TAG="latest"
# DDNS_UPDATER_IP_VERSION="ipv4 or ipv6"
# DDNS_UPDATER_LOG_LEVEL="info"
# DDNS_UPDATER_PGID=1001
# DDNS_UPDATER_PUID=1001
# DDNS_UPDATER_TTL=60

# --- Pi-hole ---
PIHOLE_WEB_PASSWORD="your_pihole_password"

# PIHOLE_DOCKER_TAG="2026.06.0"
# PIHOLE_PGID=1002
# PIHOLE_PUID=1002
# PIHOLE_SUBDOMAIN="pihole"

# --- Traefik Reverse Proxy ---
TRAEFIK_ACME_EMAIL="your@mail.com"
TRAEFIK_DASHBOARD_CREDENTIALS="admin:$$apr1$$4vqie50r$$YQAmQdtmz5n9rEALhxJ4l."

# TRAEFIK_ACME_CASERVER="https://acme-staging-v02.api.letsencrypt.org/directory"
# TRAEFIK_DOCKER_TAG="v3"
# TRAEFIK_LOG_LEVEL="info"
# TRAEFIK_PGID=1003
# TRAEFIK_PUID=1003
# TRAEFIK_SUBDOMAIN="traefik"


###############################################################################
# SECTION 3: CORE / SYSTEM
###############################################################################

# --- Watchtower (Container Updater) ---
# WATCHTOWER_DOCKER_TAG="latest"
# WATCHTOWER_LOG_LEVEL="info"
# WATCHTOWER_POLL_INTERVAL=900


###############################################################################
# SECTION 4: APPS
###############################################################################

# --- Home Assistant ---

# Core Home Assistant
# HOMEASSISTANT_DOCKER_TAG="2026.7"
# HOMEASSISTANT_LOG_LEVEL="info"
# HOMEASSISTANT_SUBDOMAIN="home"

# Extensions
# HOMEASSISTANT_EXT_ARSMARTIR_BUILDER_DOCKER_TAG="latest"
# HOMEASSISTANT_EXT_ARSMARTIR_DOCKER_TAG="latest"
# HOMEASSISTANT_EXT_SPOOK_DOCKER_TAG="latest"
# HOMEASSISTANT_EXT_BUTTON_CARD_DOCKER_TAG="latest"
# HOMEASSISTANT_EXT_HA_WASHDATA_DOCKER_TAG="latest"
# HOMEASSISTANT_EXT_HASS_GA_MANUAL_UI_DOCKER_TAG="latest"
# HOMEASSISTANT_EXT_LOVELACE_ENTITY_PROGRESS_CARD_DOCKER_TAG="latest"
# HOMEASSISTANT_EXT_LOVELACE_MUSHROOM_DOCKER_TAG="latest"
# HOMEASSISTANT_EXT_STREAMLINE_CARD_DOCKER_TAG="latest"

# --- Owncloud Infinity Scale (oCIS) Stack ---

# Core oCIS
OCIS_SMTP_HOST="smtp.example.com"
OCIS_SMTP_PASSWORD="your_smtp_password"
OCIS_SMTP_SENDER="oCIS noreply <noreply@localhost>"
OCIS_SMTP_USERNAME="your_smtp_user"

# OCIS_DOCKER_TAG="8.0"
# OCIS_LOG_LEVEL="info"
# OCIS_PGID=1004
# OCIS_PUID=1004
# OCIS_SMTP_AUTHENTICATION="login"
# OCIS_SMTP_PORT=465
# OCIS_SUBDOMAIN="ocis"

# OnlyOffice (Document Server)
OCIS_ONLYOFFICE_DB_PASSWORD="your_onlyoffice_password"
OCIS_ONLYOFFICE_JWT_SECRET="your_jwt_secret"

# OCIS_ONLYOFFICE_DOCKER_TAG="9.3"

# Web Extensions
# OCIS_EXT_3D_VIEWER_DOCKER_TAG="0.1.0"
# OCIS_EXT_ADV_SEARCH_DOCKER_TAG="latest"
# OCIS_EXT_APP_TOKENS_DOCKER_TAG="latest"
# OCIS_EXT_DRAWIO_DOCKER_TAG="latest"
# OCIS_EXT_EXCALIDRAW_DOCKER_TAG="latest"
# OCIS_EXT_JSON_VIEWER_DOCKER_TAG="latest"
# OCIS_EXT_PHOTO_ADDON_DOCKER_TAG="latest"
# OCIS_EXT_UNZIP_DOCKER_TAG="latest"

# --- Roundcube Webmail ---
ROUNDCUBE_DB_PASSWORD="your_roundcube_password"
ROUNDCUBE_IMAP_HOST="ssl://your.mail.provider"
ROUNDCUBE_SMTP_SERVER="ssl://your.mail.provider"

# ROUNDCUBE_DOCKER_TAG="1.7-nonroot"
# ROUNDCUBE_IMAP_PORT=993
# ROUNDCUBE_PGID=1005
# ROUNDCUBE_PUID=1005
# ROUNDCUBE_SMTP_PORT=465
# ROUNDCUBE_SUBDOMAIN="mail"

# --- Web Services (Static Sites) ---
# WEB_AARONSOFT_DOCKER_TAG="latest"
# WEB_GETORGANICED_DOCKER_TAG="latest"
# WEB_SUBDOMAIN="www"

# --- Zigbee (Zigbee2MQTT & Mosquitto) ---
ZIGBEE_DASHBOARD_CREDENTIALS="admin:$$apr1$$4vqie50r$$YQAmQdtmz5n9rEALhxJ4l."
ZIGBEE_MOSQUITTO_PASSWORD_HA="your_zigbee_homeassistant_password"
ZIGBEE_MOSQUITTO_PASSWORD_Z2M="your_ZIGBEE_MOSQUITTO_PASSWORD_Z2M"

# ZIGBEE_PGID="1006"
# ZIGBEE_PUID="1006"
# ZIGBEE_SUBDOMAIN="z2m"
# ZIGBEE_Z2M_SERIAL_ADAPTER="ember"
